<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back"
                style="@style/Widget.MediMind.IconButton"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eyebrow_medication"
                    android:textAppearance="@style/TextAppearance.MediMind.Section" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/eyebrow_new_medication"
                    android:textAppearance="@style/TextAppearance.MediMind.Title"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:text="@string/section_details"
            android:textAppearance="@style/TextAppearance.MediMind.Section" />

        <EditText
            android:id="@+id/name"
            style="@style/Widget.MediMind.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_name"
            android:importantForAutofill="no"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/dose"
            style="@style/Widget.MediMind.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:hint="@string/hint_dose"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/instructions"
            style="@style/Widget.MediMind.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:gravity="top|start"
            android:hint="@string/hint_instructions"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:text="@string/section_schedule"
            android:textAppearance="@style/TextAppearance.MediMind.Section" />

        <EditText
            android:id="@+id/startDate"
            style="@style/Widget.MediMind.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:drawableStart="@drawable/ic_calendar"
            android:drawablePadding="10dp"
            android:drawableTint="@color/primary"
            android:focusable="false"
            android:hint="@string/hint_start_date"
            android:importantForAutofill="no"
            android:inputType="date" />

        <EditText
            android:id="@+id/endDate"
            style="@style/Widget.MediMind.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:clickable="true"
            android:drawableStart="@drawable/ic_calendar"
            android:drawablePadding="10dp"
            android:drawableTint="@color/primary"
            android:focusable="false"
            android:hint="@string/hint_end_date"
            android:importantForAutofill="no"
            android:inputType="date" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:text="@string/section_times"
            android:textAppearance="@style/TextAppearance.MediMind.Section" />

        <LinearLayout
            android:id="@+id/times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/addTime"
            style="@style/Widget.MediMind.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:text="@string/action_add_time" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:text="@string/section_days"
            android:textAppearance="@style/TextAppearance.MediMind.Section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/monday"
                style="@style/Widget.MediMind.CheckBox"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_day_toggle"
                android:button="@null"
                android:gravity="center"
                android:minHeight="44dp"
                android:text="@string/day_letter_monday"
                android:textColor="@color/day_toggle_text"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/tuesday"
                style="@style/Widget.MediMind.CheckBox"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_day_toggle"
                android:button="@null"
                android:gravity="center"
                android:minHeight="44dp"
                android:text="@string/day_letter_tuesday"
                android:textColor="@color/day_toggle_text"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/wednesday"
                style="@style/Widget.MediMind.CheckBox"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_day_toggle"
                android:button="@null"
                android:gravity="center"
                android:minHeight="44dp"
                android:text="@string/day_letter_wednesday"
                android:textColor="@color/day_toggle_text"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/thursday"
                style="@style/Widget.MediMind.CheckBox"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_day_toggle"
                android:button="@null"
                android:gravity="center"
                android:minHeight="44dp"
                android:text="@string/day_letter_thursday"
                android:textColor="@color/day_toggle_text"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/friday"
                style="@style/Widget.MediMind.CheckBox"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_day_toggle"
                android:button="@null"
                android:gravity="center"
                android:minHeight="44dp"
                android:text="@string/day_letter_friday"
                android:textColor="@color/day_toggle_text"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/saturday"
                style="@style/Widget.MediMind.CheckBox"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_day_toggle"
                android:button="@null"
                android:gravity="center"
                android:minHeight="44dp"
                android:text="@string/day_letter_saturday"
                android:textColor="@color/day_toggle_text"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/sunday"
                style="@style/Widget.MediMind.CheckBox"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_day_toggle"
                android:button="@null"
                android:gravity="center"
                android:minHeight="44dp"
                android:text="@string/day_letter_sunday"
                android:textColor="@color/day_toggle_text"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:text="@string/section_stock"
            android:textAppearance="@style/TextAppearance.MediMind.Section" />

        <CheckBox
            android:id="@+id/stockTracking"
            style="@style/Widget.MediMind.CheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:buttonTint="@color/primary"
            android:text="@string/stock_tracking_toggle" />

        <LinearLayout
            android:id="@+id/stockFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/stockQuantity"
                style="@style/Widget.MediMind.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:hint="@string/hint_stock_quantity"
                android:importantForAutofill="no"
                android:inputType="number" />

            <EditText
                android:id="@+id/unitsPerDose"
                style="@style/Widget.MediMind.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:hint="@string/hint_units_per_dose"
                android:importantForAutofill="no"
                android:inputType="number" />

            <EditText
                android:id="@+id/lowStockThreshold"
                style="@style/Widget.MediMind.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:hint="@string/hint_low_stock_threshold"
                android:importantForAutofill="no"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xlarge"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/cancel"
                style="@style/Widget.MediMind.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_cancel" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/save"
                style="@style/Widget.MediMind.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_small"
                android:layout_weight="1"
                android:text="@string/action_save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
